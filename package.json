{
  "name": "@misterpea/schwab-frame",
  "version": "0.1.0",
  "description": "Electron and React app frame for @misterpea/schwab-node applications.",
  "type": "module",
  "main": "dist/main/main.js",
  "files": [
    "dist",
    "src",
    "index.html",
    "README.md"
  ],
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "keywords": [
    "schwab",
    "electron",
    "react",
    "template",
    "trading"
  ],
  "author": "Perry Angelora",
  "license": "MIT",
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@misterpea/schwab-node": "^0.5.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.7",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "jsdom": "^28.1.0",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.3"
  }
}

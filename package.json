{
  "name": "@misterpea/schwab-frame",
  "version": "0.0.4",
  "description": "Electron + React app frame for building desktop tools on top of the Charles Schwab API.",
  "type": "module",
  "main": "dist/main/main.js",
  "homepage": "https://github.com/MisterPea/schwab-frame#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MisterPea/schwab-frame.git"
  },
  "bugs": {
    "url": "https://github.com/MisterPea/schwab-frame/issues"
  },
  "files": [
    "dist",
    "src",
    "index.html",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.main.json && concurrently -k \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "schwab",
    "electron",
    "react",
    "template",
    "trading"
  ],
  "author": "Perry Angelora",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.2.7",
    "@misterpea/schwab-node": "file:../@misterpea__schwab-node/misterpea-schwab-node-0.6.0.tgz",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.7",
    "keytar": "^7.9.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "jsdom": "^28.1.0",
    "sass": "^1.99.0",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.3"
  }
}
